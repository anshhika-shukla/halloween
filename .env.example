LLM_PROVIDER=ollama            # ollama | openai-compat | mock
OLLAMA_HOST=http://127.0.0.1:11434
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8080/v1   # llama.cpp, vLLM, LM Studio
CHAT_MODEL=qwen2.5-coder:7b
EMBED_MODEL=nomic-embed-text
OFFLINE_MODE=0                 # 1 = network tripwire on, local sources only
GITHUB_TOKEN=                  # optional, raises GitHub rate limit
DATA_DIR=./data
PROMPTS_DIR=./apps/api/prompts
MAX_FILE_BYTES=200000
MAX_CHUNKS=4000
MIN_EVIDENCE_SCORE=0.15        # mock default; calibrate for real embeddings (Phase 3)
SANDBOX=docker                 # docker | unsafe-local (fixture only) | off
ALLOW_LOCAL_SOURCES=1          # allow local paths under ./fixtures and DATA_DIR
API_PORT=4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
